<Window x:Class="HashTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hash Calculator"
        Width="1080" Height="820"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
            <TextBox x:Name="InputBox"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     AllowDrop="True"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="14"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Padding="12"
                     PreviewDragOver="InputBox_PreviewDragOver"
                     Drop="InputBox_Drop"
                     TextChanged="InputBox_TextChanged"/>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
            <CheckBox x:Name="HexBox" Content="Hex text" DockPanel.Dock="Left"
                      ToolTip="Parse the editor as hexadecimal. Spaces, commas, and a 0x prefix are allowed."/>
            <CheckBox x:Name="UpperBox" Content="Uppercase" DockPanel.Dock="Left" Margin="8,2,14,2"/>
            <Button x:Name="ComputeButton" Content="Compute" Style="{StaticResource PrimaryButton}"
                    DockPanel.Dock="Right" Margin="8,0,0,0" Click="ComputeButton_Click"/>
            <Button x:Name="CopyButton" Content="Copy result" Style="{StaticResource QuietButton}"
                    DockPanel.Dock="Right" Margin="8,0,0,0" Click="CopyButton_Click"/>
            <Button x:Name="ClearTextButton" Content="Clear text" Style="{StaticResource QuietButton}"
                    DockPanel.Dock="Right" Click="ClearTextButton_Click"/>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="FileLabel" Text="File" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
            <Button x:Name="ClearFileButton" Content="Clear" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Click="ClearFileButton_Click"/>
            <Button x:Name="BrowseButton" Content="Browse…" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Margin="0,0,8,0" Click="BrowseButton_Click"/>
            <TextBox x:Name="FilePathBox" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
        </DockPanel>

        <TextBlock x:Name="HintText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   Text="A file path takes priority over the editor. Text is read as UTF-8; hexadecimal allows spaces and a 0x prefix. Drop a file onto the editor. Double-click an algorithm to select only that one. Ctrl+Enter computes, Esc cancels."/>

        <DockPanel Grid.Row="4" Margin="0,12,0,6">
            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="120" Height="26"
                      VerticalAlignment="Center" Margin="12,0,0,0"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="LanguageBox_SelectionChanged"/>
            <TextBlock x:Name="AlgorithmLabel" Text="Algorithms" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="SelectAllButton" Content="Select all" Style="{StaticResource QuietButton}" Click="SelectAllButton_Click"/>
            <Button x:Name="SelectNoneButton" Content="Select none" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="SelectNoneButton_Click"/>
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource MutedBrush}"/>
        </DockPanel>

        <Border Grid.Row="5" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <Grid x:Name="AlgorithmBoard">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="6" Margin="0,10,0,0" Background="#E7EEEF" CornerRadius="4" Padding="10,6">
            <DockPanel>
                <ProgressBar x:Name="ComputeProgress" DockPanel.Dock="Right" Width="240" Height="10" Margin="12,0,0,0"
                             VerticalAlignment="Center" Minimum="0" Maximum="100" Visibility="Collapsed"
                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource CardBrush}"
                             BorderBrush="{StaticResource LineBrush}"/>
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
